{
  "name": "drone-growup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "playtest:platform": "node scripts/playtest-platform.mjs",
    "simulate:life": "node scripts/simulate-life.ts",
    "cashflow:life": "node scripts/life-cashflow.ts",
    "dominance:life": "node scripts/dominance-life.ts",
    "outcomes:life": "node scripts/outcome-check-life.ts",
    "playtest:life": "node scripts/playtest-life.mjs",
    "layout:life": "node scripts/layout-check-life.mjs",
    "verify": "npm run typecheck && vite build && npm test && npm run dominance:life && npm run outcomes:life && npm run cashflow:life && npm run playtest:life && npm run playtest:platform && npm run layout:life && npm run check:board -- keys",
    "check:board": "node scripts/board-life-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
